# ── Supabase Auth personnel (développement réel, preview et production) ─────
SUPABASE_URL=
# Clé publiable du même projet, utilisée par le client Auth serveur.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (service role). Strictement serveur. Ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Connexion PostgreSQL des vérifications/scripts, cible de recette par défaut.
SUPABASE_DB_URL=

# ── Recette fictive sur PostgreSQL local uniquement (optionnel) ─────────────
# Ce mode est refusé en production et si SUPABASE_URL n'est pas HTTP loopback.
# Ne pas l'activer pour valider Supabase Auth ou l'isolation de deux sessions.
# LFO_AUTH_MODE=local-fixture
# OWNER_USER_ID=00000000-0000-4000-8000-000000000001
# SESSION_SECRET=
# LOCAL_ACCESS_CODE=

# Bucket privé. Valeur attendue : family-office-documents
SUPABASE_DOCUMENTS_BUCKET=family-office-documents
# Zone de STAGING d'acquisition, privée et temporaire. STAGING ≠ COFFRE DOCUMENTAIRE : le
# coffre plafonne à 8 Mio et n'accepte qu'une liste fermée de types MIME, un FEC d'exercice
# ne tient dans ni l'un ni l'autre. Valeur attendue : family-office-import-staging
SUPABASE_IMPORT_STAGING_BUCKET=family-office-import-staging

# ── Dépôt direct au stockage (obligatoire pour l'import comptable) ───────────
# Un FEC d'exercice dépasse la taille de corps de requête qu'une fonction serverless
# accepte : le fichier va donc du NAVIGATEUR au stockage privé, sans traverser l'API. Ces
# deux variables sont les seules exposées au navigateur, et elles ne donnent accès à rien —
# les tables sont sous RLS sans policy pour `anon`, et le bucket de staging n'a AUCUNE
# policy : le jeton signé émis par le serveur est la seule autorisation.
#
# La clé de SERVICE ne doit jamais être préfixée NEXT_PUBLIC_. Celle-ci est la clé
# PUBLIABLE (anon), conçue pour être publique.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Registre d'entreprises (facultatif) ──────────────────────────────────────
# L'annuaire ouvert (API Recherche d'Entreprises) n'exige AUCUN identifiant : il fonctionne
# sans rien renseigner ici.
#
# L'INPI / RNE sert ce que l'annuaire ne sert pas — libellé de forme juridique, capital
# social, greffe, dépôts. Il exige un jeton. Absent, l'adaptateur rend `CREDENTIALS_MISSING`
# SANS aucun appel réseau : une connexion sans secret n'a rien à demander.
#
# Ce jeton est un secret SERVEUR. Ne jamais le préfixer NEXT_PUBLIC_ : le navigateur appelle
# /api/registry, et c'est le serveur qui interroge le registre.
INPI_RNE_TOKEN=

# ── Données publiques immobilières (optionnel, verticale DVF / DPE) ──────────
# Points d'accès des jeux de données PUBLICS. Vides par défaut, et un adaptateur non
# configuré rend NOT_SERVED : une CAPACITÉ NON SERVIE n'est pas une donnée absente, et
# encore moins un zéro. Aucune conclusion de marché n'est tirée d'un adaptateur muet.
#
# Ces deux variables sont lues côté SERVEUR uniquement et ne sont jamais renvoyées au
# navigateur : la route expose « configuré ou non », jamais l'URL. Un point d'accès n'est
# pas un secret, mais une URL exposée finit par recevoir un jeton en paramètre.
#
# La forme exacte des paramètres n'a PAS pu être validée contre les sources réelles depuis
# l'environnement d'agent (sortie réseau refusée) : ces adaptateurs sont donc à confronter à
# la documentation du publieur avant toute mise en production.
DVF_API_BASE_URL=
DPE_API_BASE_URL=
