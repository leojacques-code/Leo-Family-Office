# ── Accès ─────────────────────────────────────────────────────────────────────
# Obligatoires en production. Générer SESSION_SECRET avec : openssl rand -base64 32
SESSION_SECRET=
LOCAL_ACCESS_CODE=

# ── Adapter de données ────────────────────────────────────────────────────────
# local  : SQLite dans ./data (développement uniquement)
# supabase : PostgreSQL managé (production)
# Non renseigné : "supabase" si VERCEL est défini, "local" sinon.
DATA_ADAPTER=local

# ── Supabase (requis quand DATA_ADAPTER=supabase) ─────────────────────────────
SUPABASE_URL=
# Secret key (service role). Strictement serveur. Ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# UUID de l'utilisateur Supabase Auth propriétaire des données.
# Les FK "references auth.users(id)" imposent qu'il existe réellement.
OWNER_USER_ID=
# Optionnel, défaut : family-office-documents
SUPABASE_DOCUMENTS_BUCKET=

# ── Réservé à la bascule vers Supabase Auth (non utilisé aujourd'hui) ─────────
# Aucun composant client n'appelle Supabase tant que l'accès se fait par
# LOCAL_ACCESS_CODE. Ne renseigner qu'au moment de brancher Supabase Auth.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
